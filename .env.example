# Ruta del archivo SQLite.
# Local dev: una ruta relativa está bien. Producción: usa una ruta estable
# fuera de la carpeta de deploy, p.ej. /var/lib/quiniela/data.db
DATABASE_URL=./local.db

# Contraseña del admin (único que puede registrar resultados).
# Si la dejas vacía, nadie puede iniciar sesión como admin.
ADMIN_PASSWORD=

# Secreto compartido con el monitor externo (Plan A): autentica /api/monitor/*.
# Genera uno fuerte (p.ej. `openssl rand -hex 32`). Vacío = endpoints deshabilitados.
MONITOR_SECRET=
